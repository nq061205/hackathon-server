# Sao chep thanh .env (hoac export truc tiep) va doi gia tri cho khop moi truong that.
# Cac gia tri mac dinh (trong application.yml) da khop init_basic_int.txt.

# --- Database ---
HACKATHON_DB_HOST=localhost
HACKATHON_DB_PORT=5432
# LUU Y: init_basic_int.txt tao database ten "Hackathon" (co chu hoa).
HACKATHON_DB_NAME=Hackathon

# Role app_admin (doi_mat_khau_1 trong file SQL)
HACKATHON_ADMIN_USER=app_admin
HACKATHON_ADMIN_PASSWORD=doi_mat_khau_1

# Role app_viewer (doi_mat_khau_3 trong file SQL)
HACKATHON_VIEWER_USER=app_viewer
HACKATHON_VIEWER_PASSWORD=doi_mat_khau_3

# --- JWT (BAT BUOC doi truoc khi chay that, toi thieu 32 ky tu) ---
APP_JWT_SECRET=doi-secret-nay-cho-that-toi-thieu-32-ky-tu-abcdefgh
APP_JWT_EXP_MINUTES=480

# --- Server ---
SERVER_PORT=8080
